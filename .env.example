# Copier vers .env pour le développement local.
# En production (Render), ces valeurs viennent des variables d'environnement
# du dashboard, qui ont la priorité sur ce fichier.

# ── Paytech ──────────────────────────────────────────────────
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# 'test' = paiements simulés, 'prod' = paiements réels
PAYTECH_ENV=test
PAYTECH_IPN_URL=https://mouhtacimina-api.onrender.com/api/payment/ipn/

# ── Client web ───────────────────────────────────────────────
# URL publique du front Next.js. Les paiements lancés depuis le navigateur
# y reviennent (pages /paiement/succes et /paiement/annule).
WEB_BASE_URL=http://localhost:3000

# ── Django ───────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=
# Base de données de production ; laisser vide en local pour utiliser Postgres
DATABASE_URL=
DB_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
# Origines web autorisées en plus de WEB_BASE_URL (séparées par des virgules),
# par exemple un futur nom de domaine : https://mouhtacimina.org
CORS_EXTRA_ORIGINS=
